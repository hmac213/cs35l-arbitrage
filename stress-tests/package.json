{
  "name": "arbitrage-stress-tests",
  "version": "1.0.0",
  "description": "Artillery stress tests for Arbitrage Dashboard API and WebSocket endpoints",
  "scripts": {
    "test:ws": "artillery run websocket-load.yml",
    "test:ws:quick": "artillery run websocket-quick.yml",
    "test:ws:advanced": "artillery run websocket-advanced.yml",
    "test:api": "artillery run api-load.yml",
    "test:api:quick": "artillery run api-quick.yml",
    "test:all": "npm run test:api && npm run test:ws",
    "test:ws:cloud": "artillery run --dotenv ../.env --record websocket-load.yml",
    "test:api:cloud": "artillery run --dotenv ../.env --record api-load.yml",
    "test:ws:report": "artillery run --output reports/ws-report.json websocket-load.yml",
    "test:api:report": "artillery run --output reports/api-report.json api-load.yml",
    "clean": "rm -rf reports/*.json reports/*.html"
  },
  "devDependencies": {
    "artillery": "^2.0.0",
    "artillery-plugin-expect": "^2.0.0",
    "dotenv-cli": "^7.4.0"
  },
  "keywords": [
    "stress-testing",
    "load-testing",
    "artillery",
    "websocket",
    "api-testing"
  ]
}
